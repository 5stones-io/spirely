<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; max-width: 520px; margin: 0 auto; padding: 32px 16px; color: #2c1a0e;">
  <p style="font-size: 17px; font-weight: 700;">
    <%= @author %> from <%= @church.name %> posted about <%= @names %>.
  </p>
  <p style="white-space: pre-line;"><%= @post.body %></p>
  <% if (count = @post.photos_attachments.size).positive? %>
    <p style="color: #8b6855;"><%= pluralize(count, "photo") %></p>
  <% end %>
  <p>
    <a href="<%= @url %>" style="display: inline-block; background: #00c2cb; color: #fff; padding: 10px 18px; border-radius: 999px; text-decoration: none; font-weight: 600;">See it in your Family Feed</a>
  </p>
  <p style="color: #8b6855; font-size: 13px;">Only your family and the church staff see this post.</p>
</body>
</html>
