<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; max-width: 520px; margin: 0 auto; padding: 32px 16px; color: #2c1a0e; background: #fdfaf7;">
  <p style="font-size: 20px; font-weight: 700; margin: 0 0 24px; text-align: center;"><%= @church.name %></p>
  <div style="background: #ffffff; border: 1px solid #e8d5c4; border-radius: 24px; padding: 28px;">
    <p style="margin: 0 0 12px; font-size: 15px;">Hi <%= @first_name %>,</p>
    <p style="margin: 0 0 18px; font-size: 18px; font-weight: 700;">
      <%= @asker %> scheduled you to <%= @slot.job_verb %> <%= @slot.group.name %>. Can you make it?
    </p>
    <table role="presentation" style="width: 100%; background: #f7f1ea; border-radius: 16px; padding: 14px 18px; font-size: 13px; margin-bottom: 20px;">
      <tr><td style="color: #8b6855; width: 84px; padding: 3px 0;">When</td><td style="font-weight: 700;"><%= @when %></td></tr>
      <% if @slot.group.location_name.present? %>
        <tr><td style="color: #8b6855; padding: 3px 0;">Where</td><td style="font-weight: 700;"><%= @slot.group.location_name %></td></tr>
      <% end %>
      <tr><td style="color: #8b6855; padding: 3px 0;">Group</td><td style="font-weight: 700;"><%= @slot.group.name %></td></tr>
      <tr><td style="color: #8b6855; padding: 3px 0;">Job</td><td style="font-weight: 700;"><%= @slot.job_label %></td></tr>
    </table>
    <table role="presentation" style="width: 100%;"><tr>
      <td style="padding-right: 6px;">
        <a href="<%= @accept_url %>" style="display:block;text-align:center;background:#00c5cd;color:#fff;padding:13px 0;border-radius:99px;text-decoration:none;font-weight:700;">Accept</a>
      </td>
      <td style="padding-left: 6px;">
        <a href="<%= @decline_url %>" style="display:block;text-align:center;border:1px solid #e8d5c4;color:#2c1a0e;padding:12px 0;border-radius:99px;text-decoration:none;font-weight:700;">Decline</a>
      </td>
    </tr></table>
    <p style="margin: 16px 0 0; font-size: 12px; color: #8b6855;">
      Tapping a button opens a page where you confirm your answer — no sign-in needed.
    </p>
  </div>
  <p style="margin-top: 18px; font-size: 11px; color: #8b6855; text-align: center;">
    You're getting this because you're part of <%= @slot.group.name %> at <%= @church.name %>.
  </p>
</body>
</html>
