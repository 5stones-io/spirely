#!/usr/bin/env bash
set -e

echo ""
echo "=== spirely local setup ==="
echo ""

echo "▶ Installing Ruby gems..."
bundle install

if [ ! -f .env ]; then
  cp .env.example .env
  echo "✅ Created .env from .env.example"
  echo "   → Open .env and fill in your database credentials"
  echo ""
else
  echo "✅ .env already exists"
fi

# Generate encryption key if missing
if grep -q "^ENCRYPTION_KEY=$" .env; then
  KEY=$(openssl rand -hex 32)
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^ENCRYPTION_KEY=$/ENCRYPTION_KEY=$KEY/" .env
  else
    sed -i "s/^ENCRYPTION_KEY=$/ENCRYPTION_KEY=$KEY/" .env
  fi
  echo "✅ Generated ENCRYPTION_KEY"
fi

# Generate Hydra system secret if missing
if grep -q "^HYDRA_SECRETS_SYSTEM=$" .env; then
  KEY=$(openssl rand -hex 32)
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^HYDRA_SECRETS_SYSTEM=$/HYDRA_SECRETS_SYSTEM=$KEY/" .env
  else
    sed -i "s/^HYDRA_SECRETS_SYSTEM=$/HYDRA_SECRETS_SYSTEM=$KEY/" .env
  fi
  echo "✅ Generated HYDRA_SECRETS_SYSTEM"
fi

echo ""
echo "=== Next steps ==="
echo ""
echo "  1. Fill in .env with your PCO and Twilio credentials (optional for local dev)"
echo "  2. bundle exec rails db:create db:migrate db:seed"
echo "  3. docker compose up hydra hydra-migrate    # brings up Hydra + runs its migrations"
echo "  4. bundle exec puma -C config/puma.rb"
echo ""
echo "  To set your account as admin:"
echo "  bundle exec rails spirely:make_admin[your@email.com]"
echo ""
